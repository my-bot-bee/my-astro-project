---
import "../styles/global.css";

const baseUrl = import.meta.env.BASE_URL;
const assetBaseUrl = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
const faviconUrl = `${assetBaseUrl}favicon.svg`;

const highlights = [
  "CPA 持证，兼具注册税务师、注册资产评估师、法律职业资格与证券从业资格",
  "8 年以上审计经验，5 年项目经理经验，累计 10 年财务相关经验",
  "主导或深度参与主板 IPO、创业板 IPO、新三板年报、国企年审与专项审计",
  "熟悉 Python 与 Excel VBA，能够将审计与财务工作流程自动化",
];

const credentials = [
  "注册会计师",
  "注册税务师",
  "注册资产评估师",
  "法律职业资格",
  "证券从业资格",
  "英语六级",
  "计算机二级",
];

const projectCards = [
  {
    title: "IPO 审计",
    detail: "参与国安达股份主板 IPO、广西天山电子股份创业板 IPO 申报期审计，熟悉发行上市审计流程与底稿要求。",
  },
  {
    title: "国企与新三板年审",
    detail: "独立负责新三板及国有企业年度审计现场工作，统筹团队分工、客户沟通、质量复核与报告交付。",
  },
  {
    title: "专项审计",
    detail: "覆盖离任审计、资金审计、财务竣工决算审计等专项项目，能够识别关键风险并确保审计报告按期出具。",
  },
];

const experience = [
  {
    period: "2024.03 - 2026.01",
    org: "中兴财光华会计师事务所福建分所",
    role: "审计三部 | 项目经理",
    points: [
      "独立负责新三板及国有企业年度审计现场工作，带领 2-4 名审计助理完成全流程审计。",
      "主导收入、成本、往来、固定资产等重要科目审计，与质控部及合伙人沟通重大事项。",
      "把控项目整体进度与审计质量，负责客户对接、项目归档及质量复核。",
    ],
  },
  {
    period: "2023.05 - 2024.02",
    org: "华兴会计师事务所厦门分所",
    role: "审计业务部 | 项目经理",
    points: [
      "负责上市公司及拟 IPO 企业现场审计，完成审计报告对接与出具。",
      "指导审计助理完成财务报表各科目审计底稿，处理报告编制与客户沟通问题。",
      "识别重大会计估计及或有负债事项，与质控部协同完成审计意见决策。",
    ],
  },
  {
    period: "2019.06 - 2023.04",
    org: "福建普和会计师事务所有限公司",
    role: "项目经理",
    points: [
      "独立承接并完成中小型企业年报审计、专项审计项目，负责客户对接与报告出具。",
      "带领团队完成税审项目，指导助理完成税审底稿，负责项目质量复核及归档。",
    ],
  },
  {
    period: "2017.11 - 2019.05",
    org: "天健会计师事务所（特殊普通合伙）",
    role: "高级审计员",
    points: [
      "参与新三板企业年度审计，独立负责往来账款、存货等科目审计及附注编制。",
      "参与广西天山电子股份有限公司 IPO 申报期审计，协助完成财务尽职调查与审计调整。",
    ],
  },
  {
    period: "2016.01 - 2017.09",
    org: "集友银行有限公司福州分行",
    role: "会计岗经办",
    points: [
      "整理分行经营数据并编制月度、季度报表，协助税务申报与凭证管理。",
      "向总部报送资金调度计划及日常业务报表，支持分行业务合规运行。",
    ],
  },
 
];

const education = [
  {
    school: "福州大学（211）",
    degree: "统招硕士 · 物流管理",
    period: "2010.09 - 2013.07",
    note: "学院王锐铭学业奖学金",
  },
  {
    school: "福州大学（211）",
    degree: "统招本科 · 物流管理",
    period: "2006.09 - 2010.07",
    note: "国家励志奖学金、专业第一奖学金、三等奖学金",
  },
];

const skills = [
  { label: "审计工具", value: "鼎信诺、审计大师" },
  { label: "编程技能", value: "Python、Excel VBA" },
  { label: "财务系统", value: "SAP、用友" },
  { label: "办公软件", value: "PPT、Word、Excel 高级应用" },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="审计经理 / 财务经理个人履历页。为保护隐私，联系方式仅在本人授权后提供。"
    />
    <meta name="robots" content="noindex, nofollow, noarchive, noimageindex" />
    <meta name="googlebot" content="noindex, nofollow, noarchive, noimageindex" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#0f172a" />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <title>林宗信 | 审计经理 / 财务经理</title>
  </head>
  <body>
    <header class="site-header" aria-label="站点导航">
      <a class="brand" href="#top" aria-label="返回首页">
        <span class="brand-mark">林</span>
        <span>林宗信</span>
      </a>
      <nav>
        <a href="#projects">项目</a>
        <a href="#experience">经历</a>
        <a href="#skills">技能</a>
        <a class="nav-cta" href="#privacy">隐私说明</a>
      </nav>
    </header>

    <main id="top">
      <section id="privacy" class="privacy-banner section-shell" aria-label="隐私与分享限制">
        <strong>隐私保护模式已开启</strong>
        <span>本页面仅限本人授权查看。未经本人明确允许，请勿转发链接、截图、复制页面内容或公开分享。</span>
      </section>

      <section class="hero section-shell" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">审计经理 / 财务经理 · 隐私保护展示版</p>
          <h1 id="hero-title">8年+审计工作经验，CPA 、税务师、资产评估师、法律职业资格、高级会计师五证俱全</h1>
          <p class="hero-summary">
            我是林宗信，福州大学 211 硕士，CPA 持证。长期从事财务及审计工作，
            擅长 IPO 审计、国企及新三板年审、专项审计，并能使用 Python 与 Excel VBA 提升审计效率，让审计判断、项目推进与最终交付更可靠
          </p>
          <div class="hero-actions" aria-label="主要操作">
            <span class="button primary disabled-button">联系方式仅授权提供</span>
            <span class="button secondary disabled-button">PDF 简历已关闭公开访问</span>
          </div>
        </div>

        <aside class="profile-panel" aria-label="联系方式和求职信息">
          <div class="avatar" aria-hidden="true">林宗信</div>
          <dl>
            <div>
              <dt>电话</dt>
              <dd>已隐藏，仅授权后提供</dd>
            </div>
            <div>
              <dt>邮箱</dt>
              <dd>已隐藏，仅授权后提供</dd>
            </div>
            <div>
              <dt>求职意向</dt>
              <dd>审计经理 / 财务经理</dd>
            </div>
            <div>
              <dt>期望薪资</dt>
              <dd>已隐藏，仅授权后沟通</dd>
            </div>
          </dl>
        </aside>
      </section>

      <section class="section-shell stats-grid" aria-label="简历核心数据">
        <article>
          <strong>8 年+</strong>
          <span>审计经验</span>
        </article>
        <article>
          <strong>5 年</strong>
          <span>项目经理经验</span>
        </article>
        <article>
          <strong>10 年</strong>
          <span>财务相关经验</span>
        </article>
        <article>
          <strong>5+ 家</strong>
          <span>新三板年报项目</span>
        </article>
      </section>

      <section class="section-shell section-grid" aria-labelledby="highlights-title">
        <div class="section-heading">
          <p class="eyebrow">Profile</p>
          <h2 id="highlights-title">个人亮点</h2>
        </div>
        <div class="highlight-list">
          {highlights.map((item) => <p>{item}</p>)}
        </div>
      </section>

      <section class="section-shell credentials" aria-label="专业资格">
        {credentials.map((item) => <span>{item}</span>)}
      </section>

      <section id="projects" class="section-shell" aria-labelledby="projects-title">
        <div class="section-heading compact">
          <p class="eyebrow">Selected Work</p>
          <h2 id="projects-title">项目亮点</h2>
        </div>
        <div class="project-grid">
          {projectCards.map((project) => (
            <article class="project-card">
              <h3>{project.title}</h3>
              <p>{project.detail}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="experience" class="section-shell section-grid" aria-labelledby="experience-title">
        <div class="section-heading">
          <p class="eyebrow">Experience</p>
          <h2 id="experience-title">工作经历</h2>
        </div>
        <div class="timeline">
          {experience.map((job) => (
            <article class="timeline-item">
              <p class="period">{job.period}</p>
              <div>
                <h3>{job.org}</h3>
                <p class="role">{job.role}</p>
                <ul>
                  {job.points.map((point) => <li>{point}</li>)}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section-shell section-grid" aria-labelledby="education-title">
        <div class="section-heading">
          <p class="eyebrow">Education</p>
          <h2 id="education-title">教育背景</h2>
        </div>
        <div class="education-list">
          {education.map((item) => (
            <article>
              <div>
                <h3>{item.school}</h3>
                <p>{item.degree}</p>
              </div>
              <p class="period">{item.period}</p>
              <p class="edu-note">{item.note}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="skills" class="section-shell section-grid" aria-labelledby="skills-title">
        <div class="section-heading">
          <p class="eyebrow">Skills</p>
          <h2 id="skills-title">专业技能</h2>
        </div>
        <div class="skill-grid">
          {skills.map((skill) => (
            <article>
              <h3>{skill.label}</h3>
              <p>{skill.value}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="section-shell contact-band" aria-labelledby="contact-title">
        <div>
          <p class="eyebrow">Privacy</p>
          <h2 id="contact-title">联系方式、完整 PDF 简历和进一步材料仅在本人明确授权后提供。</h2>
        </div>
        <div class="contact-actions">
          <span class="button primary disabled-button">禁止未经允许分享</span>
          <span class="button secondary disabled-button">请通过授权渠道联系</span>
        </div>
      </section>
    </main>

    <footer>
      <p>© 2026 林宗信.</p>
    </footer>
  </body>
</html>


